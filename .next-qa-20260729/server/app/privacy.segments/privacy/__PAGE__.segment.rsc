3:["$","article","How Information Is Used",{"id":"policy-2","className":"scroll-mt-32 border-t border-line py-8 first:border-t-0 first:pt-0","children":[["$","p",null,{"className":"text-[10px] font-semibold text-gold","children":"02"}],["$","h2",null,{"className":"mt-2 text-xl font-semibold sm:text-2xl","children":"How Information Is Used"}],["$","div",null,{"className":"mt-4 space-y-4","children":[["$","p","Information is used to provide the storefront, process orders, calculate delivery, prevent fraud, support customers, maintain inventory, improve site performance, and communicate where permission or another lawful basis applies.",{"className":"text-sm leading-7 text-copy-muted","children":"Information is used to provide the storefront, process orders, calculate delivery, prevent fraud, support customers, maintain inventory, improve site performance, and communicate where permission or another lawful basis applies."}],["$","p","Payment card details are handled by our payment provider and are not stored in full by ỌNUỌRA.",{"className":"text-sm leading-7 text-copy-muted","children":"Payment card details are handled by our payment provider and are not stored in full by ỌNUỌRA."}]]}],null]}]
4:["$","article","Sharing And Service Providers",{"id":"policy-3","className":"scroll-mt-32 border-t border-line py-8 first:border-t-0 first:pt-0","children":[["$","p",null,{"className":"text-[10px] font-semibold text-gold","children":"03"}],["$","h2",null,{"className":"mt-2 text-xl font-semibold sm:text-2xl","children":"Sharing And Service Providers"}],["$","div",null,{"className":"mt-4 space-y-4","children":[["$","p","We share only the information reasonably required by trusted providers supporting payment, hosting, authentication, analytics, communication, fulfilment, and delivery. Providers are expected to process data for agreed purposes and protect it appropriately.",{"className":"text-sm leading-7 text-copy-muted","children":"We share only the information reasonably required by trusted providers supporting payment, hosting, authentication, analytics, communication, fulfilment, and delivery. Providers are expected to process data for agreed purposes and protect it appropriately."}],["$","p","We may disclose information where required by law, to protect customers or the business, or in connection with a legitimate corporate transaction.",{"className":"text-sm leading-7 text-copy-muted","children":"We may disclose information where required by law, to protect customers or the business, or in connection with a legitimate corporate transaction."}]]}],null]}]
5:["$","article","Retention And Security",{"id":"policy-4","className":"scroll-mt-32 border-t border-line py-8 first:border-t-0 first:pt-0","children":[["$","p",null,{"className":"text-[10px] font-semibold text-gold","children":"04"}],["$","h2",null,{"className":"mt-2 text-xl font-semibold sm:text-2xl","children":"Retention And Security"}],["$","div",null,{"className":"mt-4 space-y-4","children":[["$","p","Records are retained for as long as required to provide services, satisfy legal and accounting obligations, resolve disputes, and maintain security. Retention periods vary by record type.",{"className":"text-sm leading-7 text-copy-muted","children":"Records are retained for as long as required to provide services, satisfy legal and accounting obligations, resolve disputes, and maintain security. Retention periods vary by record type."}],["$","p","ỌNUỌRA uses access controls, encrypted connections, service separation, and operational monitoring. No online system is risk-free, and customers should use a unique password and protect their devices.",{"className":"text-sm leading-7 text-copy-muted","children":"ỌNUỌRA uses access controls, encrypted connections, service separation, and operational monitoring. No online system is risk-free, and customers should use a unique password and protect their devices."}]]}],null]}]
6:["$","article","Your Choices And Rights",{"id":"policy-5","className":"scroll-mt-32 border-t border-line py-8 first:border-t-0 first:pt-0","children":[["$","p",null,{"className":"text-[10px] font-semibold text-gold","children":"05"}],["$","h2",null,{"className":"mt-2 text-xl font-semibold sm:text-2xl","children":"Your Choices And Rights"}],["$","div",null,{"className":"mt-4 space-y-4","children":[["$","p","Depending on your location, you may request access, correction, deletion, restriction, portability, or objection regarding your personal information. You may also withdraw marketing consent at any time.",{"className":"text-sm leading-7 text-copy-muted","children":"Depending on your location, you may request access, correction, deletion, restriction, portability, or objection regarding your personal information. You may also withdraw marketing consent at any time."}],["$","p","We may need to verify identity before completing a request and may retain information where law or a legitimate operational requirement permits.",{"className":"text-sm leading-7 text-copy-muted","children":"We may need to verify identity before completing a request and may retain information where law or a legitimate operational requirement permits."}]]}],null]}]
